# APP_URL: URL onde o servidor da AURA está hospedado
APP_URL="http://localhost:3000"

# OPENROUTER_API_KEY: Chave secreta de autenticação do OpenRouter (utilizada exclusivamente no backend Node.js)
# Obtenha sua chave gratuita ou personalizada em: https://openrouter.ai/keys
# NUNCA exponha esta chave no código React, no repositório git ou no navegador.
OPENROUTER_API_KEY=

# TAVILY_API_KEY: Chave da API de pesquisa na web Tavily (utilizada exclusivamente no backend Node.js)
# Obtenha em: https://tavily.com
# Usada para buscas automáticas na internet quando a pergunta exige fatos atuais ou recentes.
TAVILY_API_KEY=
